#!/bin/sh
# golden-census — the command, for a checkout and for an install that keeps
# this launcher beside the package.
#
# `bin/golden-census …` (or a symlink to it from anywhere on PATH) runs the
# same CLI `python3 -m golden_census …` runs, under an interpreter this script
# LOCATES rather than assumes. Symlinks are resolved first, so the package is found from the
# launcher's REAL home and not from wherever the symlink sits. `-P` keeps the working
# directory off `sys.path`, so a `golden_census` in it never shadows this one.
#
# INTERPRETER LOCATION — the floor is 3.11, because `core` imports `tomllib`
# and the manifest, the census and the mutants file are TOML:
#
#   1. $GOLDEN_CENSUS_PYTHON, when set, wins — and is still CHECKED. An override
#      naming a pre-3.11 interpreter is refused with the floor and the
#      variable named, never silently replaced by a search and never crashed
#      into: a 3.9 handed the package dies at `import tomllib` with a
#      traceback that says nothing about why.
#   2. Otherwise a FIXED range of versioned names, newest first — python3.15
#      down to python3.11 — then a bare `python3` that PROVES it is 3.11+.
#      The range is fixed rather than this machine's inventory: a launcher
#      naming only the interpreters it was written beside breaks on the next
#      machine. Absent names skip silently; an absent interpreter is not an
#      error, it is a name that is not there.
#   3. Nothing qualifies: one sentence naming the floor and the override
#      variable, a `next:` line, exit 2.
#
# A candidate qualifies by RUNNING and proving `sys.version_info` — a name on
# PATH, a broken symlink and an old interpreter all fail the same probe. On a
# default macOS PATH bare `python3` is /usr/bin/python3 3.9.6: it is skipped,
# not fallen through to, and the proof step is what makes that true.

set -u
# `cd` resolves a relative name through CDPATH; this launcher's home is its own.
unset CDPATH

SELF="$0"
while [ -h "$SELF" ]; do
  DIR="$(cd "$(dirname "$SELF")" && pwd)"
  SELF="$(readlink "$SELF")"
  case "$SELF" in
    /*) ;;
    *) SELF="$DIR/$SELF" ;;
  esac
done
HERE="$(cd "$(dirname "$SELF")" && pwd)"
ROOT="$(cd "$HERE/.." && pwd)"

refuse() {
  echo "REFUSED: $1"
  echo "  next: $2"
  exit 2
}

[ -d "$ROOT/golden_census" ] || {
  echo "REFUSED: no golden_census package at $ROOT/golden_census — this launcher runs the package one directory up from itself, and there is none there."
  echo "  next: Run bin/golden-census from a checkout of golden-census, or from an install that keeps bin/ beside the package."
  exit 2
}

qualifies() {
  command -v "$1" >/dev/null 2>&1 &&
  "$1" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 11) else 1)' >/dev/null 2>&1
}

if [ -n "${GOLDEN_CENSUS_PYTHON:-}" ]; then
  qualifies "$GOLDEN_CENSUS_PYTHON" ||
    refuse "GOLDEN_CENSUS_PYTHON=$GOLDEN_CENSUS_PYTHON is not a Python 3.11+ interpreter, and golden-census needs one: it reads TOML with tomllib, which arrived in 3.11." \
           "Point GOLDEN_CENSUS_PYTHON at a Python 3.11+ interpreter, or unset it."
  PY="$GOLDEN_CENSUS_PYTHON"
else
  PY=""
  for candidate in python3.15 python3.14 python3.13 python3.12 python3.11 python3; do
    if qualifies "$candidate"; then
      PY="$candidate"
      break
    fi
  done
  [ -n "$PY" ] ||
    refuse "no Python 3.11+ interpreter found on PATH (tried python3.15 down to python3.11, then a bare python3), and golden-census needs one: it reads TOML with tomllib, which arrived in 3.11." \
           "Install a Python 3.11+ interpreter (for example \`brew install python3\`), or point GOLDEN_CENSUS_PYTHON at one."
fi

PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONPATH
exec "$PY" -P -m golden_census "$@"
